# Banco de dados (default: SQLite local). Trocar por uma URL Postgres no futuro sem mudar código.
DATABASE_URL=sqlite:///nosso_valuation.db

# Opcional: token gratuito da brapi.dev (https://brapi.dev), usado como
# fonte de fallback caso o statusinvest.com.br (fonte primaria, sem token)
# falhe. Sem token, a brapi.dev so funciona para tickers de grande liquidez.
BRAPI_TOKEN=
